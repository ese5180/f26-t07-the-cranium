#
# Cranium application settings.
#

menu "Cranium application"

# The tags of the protected TLVs in every signed image that say what it is compatible with: see
# "Board type and compatibility" in firmware/README.md and docs/fleet.md. MCUboot leaves 0x00a0 to
# 0x00ff to vendors.
CRANIUM_BOARD_TLV := 0xa1
CRANIUM_LAYOUT_TLV := 0xa2

# Each board's flash layout number. It goes up whenever its partitions change, and
# firmware/app/flash_layouts.json holds what its partitions are for each number: the build stops if
# they are not those (sysbuild.cmake). The nRF5340 DK has none until its partitions are drawn.
CRANIUM_NRF7002DK_LAYOUT := 1

config APP_BOARD_TYPE
	string
	default "nrf7002dk" if BOARD_NRF7002DK_NRF5340_CPUAPP_NS || BOARD_NRF7002DK_NRF5340_CPUAPP
	default "nrf5340dk" if BOARD_NRF5340DK_NRF5340_CPUAPP_NS || BOARD_NRF5340DK_NRF5340_CPUAPP
	help
	  From 1.13.0. The kind of board this image is for, as the console knows it (docs/fleet.md):
	  in the image's protected TLV, through MCUBOOT_EXTRA_IMGTOOL_ARGS below, and in the
	  diagnostics report. It follows from the board and cannot be set: CMakeLists.txt stops a build
	  for a board that has none, and one whose image would not say it.

config APP_IMAGE_LAYOUT
	int
	default $(CRANIUM_NRF7002DK_LAYOUT) if BOARD_NRF7002DK_NRF5340_CPUAPP_NS || BOARD_NRF7002DK_NRF5340_CPUAPP
	default 0
	help
	  From 1.13.0. The number of this board's flash layout: its partitions, its slot sizes and the
	  golden area. In the image's protected TLV 0xa2 and in the diagnostics report, and the board
	  refuses an image of another layout. It follows from the board and cannot be set, since an
	  assignment in a .conf file has no effect on a symbol with no prompt: the number lives above,
	  next to the board's type. 0 means none, and CMakeLists.txt stops the build.

if BOOTLOADER_MCUBOOT

# Before Zephyr's own definition, which defaults to "", so these defaults come first.
config MCUBOOT_EXTRA_IMGTOOL_ARGS
	default "--custom-tlv $(CRANIUM_BOARD_TLV) nrf7002dk --custom-tlv $(CRANIUM_LAYOUT_TLV) $(CRANIUM_NRF7002DK_LAYOUT)" if BOARD_NRF7002DK_NRF5340_CPUAPP_NS || BOARD_NRF7002DK_NRF5340_CPUAPP
	default "--custom-tlv $(CRANIUM_BOARD_TLV) nrf5340dk" if BOARD_NRF5340DK_NRF5340_CPUAPP_NS || BOARD_NRF5340DK_NRF5340_CPUAPP

endif # BOOTLOADER_MCUBOOT

# Before the definitions in the nRF Connect SDK's Memfault module, for the same reason. What Memfault
# calls the firmware is what MCUboot and the shadow call it, "1.14.0+0": the module's own default
# asks for $(VERSION_MAJOR), which nothing gives Kconfig, and would leave it empty. And the hardware
# is the board type, as the console and the image's TLV say it, not the Zephyr board name.
if MEMFAULT

config MEMFAULT_NCS_FW_VERSION
	default "$(APP_VERSION_TWEAK_STRING)" if MEMFAULT_NCS_FW_VERSION_STATIC

config MEMFAULT_NCS_HW_VERSION
	default APP_BOARD_TYPE

endif # MEMFAULT

config APP_THING_NAME_PREFIX
	string "Prefix of the AWS IoT thing name"
	default "cranium-"
	help
	  The thing name, which is also the MQTT client ID, is this prefix followed by
	  the SoC's factory-programmed device identifier.

config APP_DOWNLOAD_SEC_TAG
	int "TLS security tag for firmware downloads"
	default 202
	help
	  Holds only the root CA used to verify the download server. The device
	  certificate and private key are under CONFIG_MQTT_HELPER_SEC_TAG and are not
	  loaded for downloads.

config APP_SHADOW_INTERVAL_SECONDS
	int "Seconds between heartbeats: the periodic device shadow reports"
	default 30
	range 10 3600
	help
	  The console calls a board online if AWS IoT received one of these within the last
	  90 seconds (ONLINE_WINDOW_MS in cloud/api/src/lib/shadow.mjs). There is no second
	  message for this and no last will: this report is the heartbeat.

config APP_DIAG_INTERVAL_SECONDS
	int "Seconds between diagnostics reports"
	default 300
	range 60 86400
	help
	  The Wi-Fi address and channel and the heap, for the console's diagnostics page (src/diag.h).
	  Sent when the board reaches the cloud and this often after, as a report of its own, so that
	  the heartbeat stays short.

config APP_CLOUD_RETRY_SECONDS
	int "Seconds to wait before the first retry of a failed cloud connection"
	default 30
	range 5 600
	help
	  The wait doubles after every failure, up to five minutes.

config APP_WATCHDOG_TIMEOUT_SECONDS
	int "Hardware watchdog timeout"
	default 120
	range 30 600
	help
	  The main event loop feeds the watchdog. If the loop stops, the device resets,
	  and an update that has not been confirmed yet is reverted by the bootloader.

config APP_OTA_REQUIRE_USER_CONSENT
	bool "Wait for a button press before installing an update"
	default n
	help
	  Off: an update that passed every check starts as soon as the board sees the job,
	  with nobody at the board. The signature check, the version check, the trial and
	  the revert hold either way.

	  On, for a product that wants a person to agree: such an update is only offered. It
	  is downloaded and installed after Button 1 is pressed, and refused if Button 2 is
	  pressed. Firmware before 1.7.2 was built this way, and that includes the golden image.

config APP_OTA_SELF_TEST_TIMEOUT_SECONDS
	int "Seconds a new image has to prove itself"
	default 300
	range 60 3600
	help
	  A newly installed image runs on trial. If it has not reconnected to the cloud
	  within this time, the device resets and the bootloader restores the previous
	  image.

config APP_OTA_DOWNLOAD_ATTEMPTS
	int "Download attempts per update before it is reported as failed"
	default 5
	range 1 10
	help
	  The wait before another attempt grows with each one: 10 s, 20 s, 30 s and 40 s
	  with the default, so that an update survives a short outage of the network.

config APP_CONSOLE
	bool "Serial console for setup and debugging"
	depends on SERIAL && LOG
	default y
	select UART_INTERRUPT_DRIVEN
	select RING_BUFFER
	select BASE64
	select SYS_HEAP_RUNTIME_STATS
	help
	  One command per line on uart0: set the device ID, the Wi-Fi network and the
	  cloud settings, load the device credentials, check the status and reset the
	  board, without a host application or a reflash. Log messages come out here as
	  well. For development and provisioning builds only; a release build turns this
	  off with -Dapp_CONFIG_APP_CONSOLE=n, and its log messages then go nowhere. Nothing
	  here can read a secret back out of the device.

if APP_CONSOLE

config APP_CONSOLE_STACK_SIZE
	int "Stack of the console task"
	default 6144
	help
	  Creating the device key and its signing request runs on this stack.

config APP_CONSOLE_THREAD_PRIORITY
	int "Priority of the console task"
	default 12
	help
	  Lower than everything that keeps the product running, and higher than the log
	  thread, so that a reply goes out before the log lines it caused.

config APP_CONSOLE_TX_BUFFER_SIZE
	int "Bytes of output that can wait to be sent"
	default 4096
	range 1024 16384
	help
	  The console task waits for room here. Other threads never do: their line is
	  dropped and counted when it does not fit.

config APP_CONSOLE_LOG_HOLD_SIZE
	int "Bytes of log lines that can wait for a reply to finish"
	default 1024
	range 256 4096
	help
	  They go out all at once, so this cannot be larger than the transmit buffer.

config APP_CONSOLE_RX_BUFFER_SIZE
	int "Bytes of input that can wait for the console task"
	default 512
	range 128 2048

endif # APP_CONSOLE

config APP_CLOUD_EVENTS
	bool "Send what the console says about the board to AWS IoT"
	depends on APP_CONSOLE
	default y
	help
	  From 1.12.0. Every line of console_event() and of this application's log modules also goes to
	  cranium/<thing name>/events, for the console in the cloud. src/cloud_events.c keeps out the
	  Bluetooth passkey and anything like a secret, and replaces network names and URLs. Lines wait
	  in RAM while the board is offline, the last 32 of them, and at most 5 a second (20 at once)
	  get in. The device policy in AWS IoT has to allow publishing there: see "Events to the console"
	  in firmware/README.md.

config APP_LOCATION
	bool "Send what Wi-Fi access points the board hears, for a position"
	depends on WIFI
	default y
	help
	  From 1.13.0. Up to 10 access points, by address and signal and never by name, to
	  cranium/<thing name>/location: once a boot, every 6 hours and when the console asks, never
	  more often than every 10 minutes, and never during an update or while Bluetooth is open.
	  The device policy in AWS IoT has to allow publishing there. See "Location" in
	  firmware/README.md and docs/fleet.md.

config APP_BT_OTA
	bool "Firmware update over Bluetooth LE"
	depends on APP_CONSOLE && BT
	help
	  MCUmgr over Bluetooth LE, writing the secondary slot. Off by default. Build with
	  -DSB_EXTRA_CONF_FILE=bt_ota_sysbuild.conf, which also puts the Bluetooth controller on
	  the network core: see firmware/README.md. It needs the console, which is the only way
	  a person can see the passkey.

if APP_BT_OTA

config APP_BT_OTA_WINDOW_SECONDS
	int "Seconds that Button 1 opens Bluetooth for"
	default 180
	range 30 600
	help
	  Advertising stops after this, or as soon as a phone has connected. An authenticated
	  link can run on past it, as long as something happens on it.

config APP_BT_OTA_TRIAL_MIN_SECONDS
	int "Seconds a new image must have run before a person can keep it"
	default 60
	range 30 APP_OTA_SELF_TEST_TIMEOUT_SECONDS
	help
	  An image installed over Bluetooth, on a board that cannot reach Wi-Fi, can be kept by
	  a person at the board: see firmware/README.md. This long first, so that an image that
	  falls over soon after it starts does not get kept, and Wi-Fi has its chance.

endif # APP_BT_OTA

config APP_MEMFAULT
	bool "Memfault: coredumps, metrics and reboot reasons, sent over AWS IoT"
	depends on MEMFAULT
	default y
	help
	  From 1.14.0 (docs/memfault.md). The Memfault SDK keeps a coredump of the last crash in RAM,
	  the reason of each reboot and an hourly heartbeat of metrics. The board never talks to
	  Memfault itself: src/mflt.c sends the SDK's chunks one at a time on its own AWS IoT
	  connection to cranium/<thing name>/memfault, and a function in AWS posts each one to
	  Memfault and answers on the commands topic, after which the next goes. No project key is
	  in the image. The device policy in AWS IoT has to allow publishing there.

if APP_MEMFAULT

config APP_MEMFAULT_CHUNK_MAX
	int "Largest Memfault chunk in one MQTT message"
	default 400
	range 64 460
	help
	  With its 3-byte header, its topic and the PUBLISH header it has to fit the MQTT buffer
	  (CONFIG_MQTT_HELPER_RX_TX_BUFFER_SIZE), which cloud.c checks when it is built.

config APP_MEMFAULT_ACK_SECONDS
	int "Seconds to wait for the cloud's answer to a chunk"
	default 20
	range 5 120
	help
	  Then the same chunk goes again, after 30 s, and the wait doubles after every chunk that
	  gets no answer, up to an hour. A chunk that the cloud answers resets it.

endif # APP_MEMFAULT

config APP_CRASH_DEMO
	bool "Crash once, on purpose, after the image is confirmed: for showing a coredump"
	depends on APP_MEMFAULT && !APP_TEST_FAULT_WIFI_DEAD
	help
	  A demonstration image, never a release. It goes through its trial and is confirmed like
	  any other, and once it has been connected for APP_CRASH_DEMO_AFTER_SECONDS it stops with
	  k_oops(), once per install: the version it crashed on is kept in storage, under the record
	  of APP_TEST_FAULT_WIFI_DEAD, which is why the two cannot be on together. The board
	  restarts, still on this image, and sends the coredump. Its log line starts with "Test
	  image:", so scripts/github-release.sh refuses it. See docs/memfault.md.

config APP_CRASH_DEMO_AFTER_SECONDS
	int "Seconds of connection after the confirmation before the crash"
	depends on APP_CRASH_DEMO
	default 60
	range 10 3600

config APP_VERSION_FROM_BUILD
	bool
	default y
	help
	  Take the firmware version from the VERSION file. Off only in host-side tests.

config APP_BOOT_DIARY
	bool "Keep a record of the last boots and send it to the shadow"
	depends on APP_CONSOLE
	default y
	help
	  For finding out over the cloud why a board reset, when nobody can read its serial
	  port. Eight entries: the version, why the boot before it ended, and how far it got.
	  It writes to storage up to four times each boot.

choice APP_TEST_FAULT
	prompt "Fault built into a test image"
	default APP_TEST_FAULT_NONE
	help
	  For testing the way back. An image with a fault is signed and installs like any
	  other, then misbehaves on trial, so the bootloader has to restore the previous
	  image, unless its help says otherwise. Build one with, for example,
	  -Dapp_CONFIG_APP_TEST_FAULT_HANG=y. Never in a release.

config APP_TEST_FAULT_NONE
	bool "No fault"

config APP_TEST_FAULT_NO_CONFIRM
	bool "Runs and reaches the cloud, but never confirms itself"

config APP_TEST_FAULT_HANG
	bool "The main loop hangs, so the watchdog fires"

config APP_TEST_FAULT_CRASH
	bool "A fatal error right after start"

config APP_TEST_FAULT_INIT_POWER_LOSS
	bool "INIT restarts just before it writes the init-complete flag"
	depends on APP_CONSOLE
	help
	  A power cut at the worst moment of first-time setup, for
	  firmware/tests/hil/console_bench.py.

config APP_TEST_FAULT_WIFI_DEAD
	bool "A console command stops the Wi-Fi chip's power, once"
	depends on APP_CONSOLE
	help
	  Nothing happens until TEST_WIFI_DEAD is sent, so this image passes its trial and is
	  confirmed like any other. The command drives BUCKEN low and leaves IOVDD on, and from
	  then on the chip answers nothing. A restart brings it back. Build it with
	  -Dapp_CONFIG_NRF_WIFI_RPU_RECOVERY=n as well, or the driver powers the chip up again
	  and the timers in src/stuck.c never fire. For the chip-dead scenario of
	  firmware/tests/hil/ota_bench.py.

	  With APP_TEST_WIFI_DEAD_AFTER_SECONDS it also fires by itself, for a board with no
	  console: chip-dead-cloud in the same file.

config APP_TEST_FAULT_WRECK_SLOTS
	bool "Damages both image slots and restarts"
	help
	  Clears a word of the primary slot's hash and the first word of the secondary slot,
	  as a compromised application could. MCUboot then has no valid image, and the golden
	  image is the way back, for firmware/tests/hil/golden_bench.py.

config APP_TEST_FAULT_GOLDEN_FLIP
	bool "Damages the golden image in external flash, and runs on"
	help
	  Clears one bit of the golden copy at APP_TEST_GOLDEN_FLIP_OFFSET, through the flash
	  device, since this application's flash map has no area for it. A restore has to refuse
	  it whether the bit is in the image or in its signature, for
	  firmware/tests/hil/golden_bench.py.

endchoice

config APP_TEST_WIFI_DEAD_AFTER_SECONDS
	int "Seconds after its confirmation that the fault fires by itself"
	depends on APP_TEST_FAULT_WIFI_DEAD
	default 0
	range 0 3600
	help
	  0: only TEST_WIFI_DEAD does it. Otherwise it fires this long after the image was
	  confirmed, counted while no update is under way and the cloud is connected, and once
	  per install: the version it fired on is kept in storage, so it does not fire again
	  after the restart it causes. An image that got here with no swap has no trailer, so a
	  revert could not show, and there it does not fire. Build it with KIND set, as in
	  KIND=wifi-dead-auto firmware/tests/hil/build_image.sh, so that its build directory is
	  not the one of the image that waits for the command.

config APP_TEST_GOLDEN_FLIP_OFFSET
	int "Offset in the golden image of the byte that loses a bit"
	depends on APP_TEST_FAULT_GOLDEN_FLIP
	default 0
	range 0 933887
	help
	  `tools/golden.py offsets` gives one in the image's body and one in its signature.

module = APP
module-str = Cranium application
source "subsys/logging/Kconfig.template.log_config"

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu

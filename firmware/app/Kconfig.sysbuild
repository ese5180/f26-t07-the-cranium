#
# Sysbuild configuration: which images are built next to the application.
#

# MCUboot is always part of the build: nothing runs unless it verified the signature.
choice BOOTLOADER
	default BOOTLOADER_MCUBOOT
endchoice

# Without this sysbuild forces the nRF70 Wi-Fi driver off in the application image. The nRF5340 DK
# has no Wi-Fi chip, and builds with Bluetooth only (prj_bt_only.conf).
config WIFI_NRF70
	default y if !BOARD_NRF5340DK

# Flash and RAM layout come from the devicetree overlays in boards/.
config PARTITION_MANAGER
	default n

# The nRF5340 network core runs this project's own image instead of a radio stack.
config SUPPORT_NETCORE_BLINKY
	bool
	default y if SOC_SERIES_NRF53

choice NETCORE

config NETCORE_BLINKY
	bool "Cranium base-function image (LED heartbeat)"
	depends on SUPPORT_NETCORE_BLINKY
	help
	  Build firmware/netcore as the network-core image. It has no radio stack,
	  no keys and no console; it only toggles an LED.

endchoice

config NETCORE_IMAGE_NAME
	default "netcore_blinky" if NETCORE_BLINKY

config NETCORE_IMAGE_PATH
	default "$(APP_DIR)/../netcore" if NETCORE_BLINKY

# Firmware update over Bluetooth LE. On in sysbuild.conf from 1.9.0; no_bt_sysbuild.conf turns it off.
config APP_BT_OTA
	bool "Firmware update over Bluetooth LE"
	help
	  Adds src/bt/bt_ota.c and the Bluetooth host to the application, through bt_ota.conf. The
	  network core has to run the Bluetooth controller, so sysbuild.conf selects that too, and
	  it has to be flashed over the debug port.

config APP_PI_OTA
	bool "Raspberry Pi image updates through the SD card and SPI"
	help
	  From 1.20.0 (docs/pi-ota.md): adds pi_ota.conf to the application. The nRF7002 DK's RAM
	  does not hold this and Bluetooth together, so pi_ota_sysbuild.conf turns Bluetooth off.

source "share/sysbuild/Kconfig"

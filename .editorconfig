# How editors should write the files here (https://editorconfig.org). Prettier reads it too, for cloud/.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,swift,kt,kts,py}]
indent_size = 4

[{Makefile,*.mk,Kconfig*,*.conf}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

#!/usr/bin/env bash
# Sets up a second SD card for A/B updates with tryboot (docs/pi-tryboot.md), from this running Pi.
# It ERASES the card it is given, and never touches the card this Pi booted from.
#
#   sudo pi/bin/cranium-ab-setup --device /dev/sda --erase /dev/sda [--root-size 6G] [--version 1.0.0]
#
# The card gets, on GPT:
#   1 autoboot  64 MB  FAT   autoboot.txt: tryboot_a_b=1, slot A by default, slot B on tryboot
#   2 boot_a   512 MB  FAT   this Pi's /boot/firmware, with cmdline.txt changed as below
#   3 boot_b   512 MB  FAT   empty; the first update writes it
#   4 root_a    6 GB   ext4  this Pi's root filesystem, changed as below
#   5 root_b    6 GB   ext4  empty; the first update writes it
#   6 data     the rest ext4 /home (Mixxx's settings and library, ~/.cranium, this repository) and the
#                            Wi-Fi connections, copied from this Pi; the update state
#
# What changes in slot A, and why the feature needs it (nothing else changes; no package is removed):
#   - cmdline.txt: root=PARTLABEL=root_a, so slot A mounts its own root (slot B's copy says root_b),
#     and overlayroot=tmpfs:recurse=0, Raspberry Pi OS's overlay file system (as raspi-config sets it,
#     but leaving /data writable): the root is mounted read-only, so the slot stays byte for byte the
#     release it was installed as, which is what lets a delta apply to it.
#   - the overlayroot package, which raspi-config installs for the same option.
#   - fstab: /data, /boot/autoboot, and /home and the Wi-Fi connections from /data, as they must
#     outlive a reboot; the root and boot partitions are not listed, as each slot has its own.
#   - swap: zram only (/etc/rpi/swap.conf.d), as a swap file on an overlay root would be in RAM.
#   - a udev rule so that the desktop never mounts a slot's partitions, which would change its bytes.
#   - cranium-update-confirm.service, enabled: it keeps or rolls back a slot on trial at boot.
#   - /etc/cranium-os: the version, 1.0.0 unless --version says otherwise.
set -euo pipefail

PI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
device="" erase="" root_size="6G" version="1.0.0"
while [ $# -gt 0 ]; do
    case "$1" in
        --device) device="$2"; shift 2 ;;
        --erase) erase="$2"; shift 2 ;;
        --root-size) root_size="$2"; shift 2 ;;
        --version) version="$2"; shift 2 ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $1 (see --help)" >&2; exit 2 ;;
    esac
done

die() { echo "cranium-ab-setup: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run it with sudo"
[ -n "$device" ] || die "--device is needed: the card to erase, such as /dev/sda (lsblk shows it)"
[ "$erase" = "$device" ] || die "to erase $device, also give --erase $device"
[ -b "$device" ] || die "$device is not a block device"
[ "$(lsblk -dno TYPE "$device")" = disk ] || die "$device is not a whole disk (give /dev/sda, not /dev/sda1)"
booted="/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
[ "$(readlink -f "$device")" != "$(readlink -f "$booted")" ] || die "$device is the card this Pi runs from"
if lsblk -no MOUNTPOINT "$device" | grep -q .; then
    die "something on $device is mounted; unmount it first (lsblk $device)"
fi
for tool in sgdisk mkfs.vfat mkfs.ext4 rsync chroot partprobe; do
    command -v "$tool" > /dev/null || PATH="$PATH:/usr/sbin:/sbin"
    command -v "$tool" > /dev/null || die "$tool is missing"
done
[[ "$version" =~ ^[0-9]+(\.[0-9]+)*$ ]] || die "--version must look like 1.0.0"

bytes() { numfmt --from=iec "$1"; }
need=$(( $(bytes 64M) + 2 * $(bytes 512M) + 2 * $(bytes "$root_size") + $(bytes 1G) ))
have=$(blockdev --getsize64 "$device")
[ "$have" -ge "$need" ] || die "$device has $(numfmt --to=iec "$have"); it needs $(numfmt --to=iec "$need") for two $root_size slots and 1 GB of data"
used=$(df --output=used -B1 / | tail -1)
swapfile=$(stat -c %s /var/swap 2>/dev/null || echo 0)
[ $(( used - swapfile )) -lt $(bytes "$root_size") ] || die "this system uses $(numfmt --to=iec $(( used - swapfile ))); it does not fit a $root_size slot (--root-size)"

echo "About to ERASE $device:"
lsblk -o NAME,SIZE,MODEL,FSTYPE,LABEL "$device"
echo "and set it up with this Pi's system as slot A, version $version, slots of $root_size."

part() { if [[ "$device" =~ [0-9]$ ]]; then echo "${device}p$1"; else echo "${device}$1"; fi; }
work=$(mktemp -d)
cleanup() {
    set +e
    for m in "$work/root/boot/firmware" "$work/root/dev" "$work/root/proc" "$work/root/sys" "$work/root/run" \
             "$work/root" "$work/boot" "$work/data" "$work/autoboot"; do
        mountpoint -q "$m" && umount "$m"
    done
    rm -rf "$work"
}
trap cleanup EXIT

echo "# partitions"
wipefs -aq "$device"
sgdisk --zap-all "$device" > /dev/null
sgdisk -n1:0:+64M -t1:0700 -c1:autoboot \
       -n2:0:+512M -t2:0700 -c2:boot_a -n3:0:+512M -t3:0700 -c3:boot_b \
       -n4:0:+"$root_size" -t4:8300 -c4:root_a -n5:0:+"$root_size" -t5:8300 -c5:root_b \
       -n6:0:0 -t6:8300 -c6:data "$device" > /dev/null
partprobe "$device"; udevadm settle
mkfs.vfat -F 32 -n AUTOBOOT "$(part 1)" > /dev/null
mkfs.vfat -F 32 -n BOOT_A "$(part 2)" > /dev/null
mkfs.vfat -F 32 -n BOOT_B "$(part 3)" > /dev/null
mkfs.ext4 -qF -L root_a "$(part 4)"
mkfs.ext4 -qF -L root_b "$(part 5)"
mkfs.ext4 -qF -L data "$(part 6)"

mkdir -p "$work/boot" "$work/root" "$work/data" "$work/autoboot"
mount "$(part 2)" "$work/boot"
mount "$(part 4)" "$work/root"
mount "$(part 6)" "$work/data"
mount "$(part 1)" "$work/autoboot"

echo "# slot A's boot partition, from /boot/firmware"
rsync -rt /boot/firmware/ "$work/boot/"
echo "# slot A's root, from / (a few minutes); not /home, the Wi-Fi connections or the swap file"
rsync -aHAX --one-file-system --exclude=/var/swap --exclude='/home/*' \
      --exclude='/etc/NetworkManager/system-connections/*' --exclude='/tmp/*' --exclude='/var/tmp/*' \
      / "$work/root/"
echo "# data: /home and the Wi-Fi connections"
rsync -aHAX /home/ "$work/data/home/"
mkdir -p "$work/data/system-connections" "$work/data/cranium-ota"
rsync -a /etc/NetworkManager/system-connections/ "$work/data/system-connections/"
chmod 700 "$work/data/system-connections"

echo "# slot A: fstab, swap, version, the confirm service"
mkdir -p "$work/root/boot/autoboot" "$work/root/data"
cat > "$work/root/etc/fstab" <<'EOF'
# Written by cranium-ab-setup (docs/pi-tryboot.md). The root is mounted by cmdline.txt (root_a or
# root_b) under the overlay; the boot partitions are not mounted. What outlives a reboot is on data.
proc                      /proc                                  proc   defaults          0 0
PARTLABEL=autoboot        /boot/autoboot                         vfat   defaults          0 2
PARTLABEL=data            /data                                  ext4   defaults,noatime  0 2
/data/home                /home                                  none   bind,x-systemd.requires-mounts-for=/data  0 0
/data/system-connections  /etc/NetworkManager/system-connections none   bind,x-systemd.requires-mounts-for=/data  0 0
EOF
mkdir -p "$work/root/etc/rpi/swap.conf.d"
printf '# cranium-ab-setup: the root is an overlay in RAM, so no swap file on it.\n[Main]\nMechanism=zram\n' \
    > "$work/root/etc/rpi/swap.conf.d/50-cranium-ab.conf"
echo "$version" > "$work/root/etc/cranium-os"
cat > "$work/root/etc/udev/rules.d/90-cranium-ab.rules" <<'EOF'
# cranium-ab-setup: the desktop (udisks) never mounts the A/B slots' partitions. A mounted slot changes
# its bytes (FAT marks itself dirty, the desktop writes trash and thumbnails), and a delta then no longer
# applies to it.
ENV{ID_PART_ENTRY_NAME}=="boot_a|boot_b|root_a|root_b", ENV{UDISKS_IGNORE}="1"
EOF
sed "s#/home/cranium/cranium/pi#$PI#g" "$PI/ota/cranium-update-confirm.service" \
    > "$work/root/etc/systemd/system/cranium-update-confirm.service"
mkdir -p "$work/root/etc/systemd/system/multi-user.target.wants"
ln -sf ../cranium-update-confirm.service "$work/root/etc/systemd/system/multi-user.target.wants/"

echo "# slot A: the overlayroot package, as raspi-config installs it (in slot A only)"
mount "$(part 2)" "$work/root/boot/firmware" 2>/dev/null || mount --bind "$work/boot" "$work/root/boot/firmware"
for fs in dev proc sys run; do mount --bind "/$fs" "$work/root/$fs"; done
printf '#!/bin/sh\nexit 101\n' > "$work/root/usr/sbin/policy-rc.d"; chmod +x "$work/root/usr/sbin/policy-rc.d"
chroot "$work/root" apt-get install -y -q overlayroot
rm -f "$work/root/usr/sbin/policy-rc.d"
umount "$work/root/boot/firmware" "$work/root/dev" "$work/root/proc" "$work/root/sys" "$work/root/run"

echo "# slot A: cmdline.txt"
cmdline="$work/boot/cmdline.txt"
sed -i -E 's/(^| )root=[^ ]+/\1root=PARTLABEL=root_a/; s/(^| )overlayroot=[^ ]+//; s/^/overlayroot=tmpfs:recurse=0 /' "$cmdline"
[ "$(grep -o 'root=PARTLABEL=root_' "$cmdline" | wc -l)" -eq 1 ] || die "cmdline.txt does not name root_a once: $(cat "$cmdline")"
cat "$cmdline"; echo

echo "# autoboot.txt and the update state"
cat > "$work/autoboot/autoboot.txt" <<'EOF'
# Written by cranium-ab-setup; cranium-update changes it. The Pi's bootloader boots [all]'s partition,
# and once [tryboot]'s after `reboot "0 tryboot"`.
[all]
tryboot_a_b=1
boot_partition=2
[tryboot]
boot_partition=3
EOF
# Only what is not in a release: the update on trial, and the last result. The version is the running
# root's own /etc/cranium-os, written above.
printf '{"last": null, "pending": null}\n' > "$work/data/cranium-ota/state.json"

sync
echo "Done. $device holds slot A ($version) and an empty slot B. Put it in the Pi's SD slot and boot from it;"
echo "then \`cranium-update status\` should say slot a, version $version. See docs/pi-tryboot.md."

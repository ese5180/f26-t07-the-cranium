+        if (::stat(QFile::encodeName(sound.filePath(name)).constData(), &node) == 0) {
+            result << QStringLiteral("%1:%2:%3:%4").arg(name)
+                              .arg(qulonglong(node.st_ino)).arg(qlonglong(node.st_ctim.tv_sec))
+                              .arg(qlonglong(node.st_ctim.tv_nsec));
+        }
+    }
+#endif
+    return result;
+}

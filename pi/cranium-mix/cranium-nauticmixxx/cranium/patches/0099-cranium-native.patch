+void PortMidiController::detachDevices() {
+    if (isOpen()) close();
+    // Both wrappers must be gone before Pm_Terminate invalidates their info.
+    m_pInputDevice.reset();
+    m_pOutputDevice.reset();
+    setInputDevice(false);
+    setOutputDevice(false);
+}
+
+void PortMidiController::attachDevices(const PmDeviceInfo* inputDeviceInfo,
+        const PmDeviceInfo* outputDeviceInfo, int inputDeviceIndex, int outputDeviceIndex) {
+    DEBUG_ASSERT(!isOpen());
+    setInputDevice(inputDeviceInfo && inputDeviceInfo->input);
+    setOutputDevice(outputDeviceInfo && outputDeviceInfo->output);
+    m_pInputDevice.reset(inputDeviceInfo ? new PortMidiDevice(inputDeviceInfo, inputDeviceIndex) : nullptr);
+    m_pOutputDevice.reset(outputDeviceInfo ? new PortMidiDevice(outputDeviceInfo, outputDeviceIndex) : nullptr);
 }
 

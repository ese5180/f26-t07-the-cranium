+QStringList midiHardwareTopology() {
+    QStringList result;
+#ifdef __LINUX__
+    // Only hardware raw-MIDI nodes: opening our own ALSA sequencer ports must
+    // not trigger an endless rescan. Inode + ctime distinguish a fast reconnect
+    // at the same card number from the original node.
+    const QDir sound(QStringLiteral("/dev/snd"));
+    for (const auto& name : sound.entryList({QStringLiteral("midiC*D*")}, QDir::System | QDir::Files, QDir::Name)) {

# Cranium on the Pi: the defaults. Do not edit this file to change them on one Pi: put the lines
# to change in ~/.config/cranium/cranium.conf (never in git), which is read after this one.
#
# Format: KEY=value or KEY="value", one per line, # for comments. $HOME and ~ are expanded.
# The scripts in bin/ read it.

# Mixxx's settings folder (mixxx.cfg, mixxx.log, mixxxdb.sqlite, controllers/). Anything other
# than ~/.mixxx makes bin/cranium-mixxx pass it to Mixxx as --settings-path.
MIXXX_DIR="$HOME/.mixxx"

# How bin/cranium-mixxx starts Mixxx:
#   native   mixxx itself, with the sound API chosen in its preferences (PipeWire, ALSA, ...)
#   pw-jack  pw-jack mixxx: Mixxx's JACK API runs on PipeWire
MIXXX_AUDIO=native

# Mixxx stops writing its log at this size (bytes). Its default, 100 MB, can be reached in a long
# set, as Mixxx writes its own debug lines there too, and the collector would then see nothing.
MIXXX_LOG_MAX_BYTES=500000000

# More arguments for Mixxx, e.g. "--fullScreen".
MIXXX_ARGS=""

# Where bin/cranium-collect writes latest.json and messages.jsonl.
CRANIUM_OUT_DIR="$HOME/.cranium"

# Seconds between heartbeat ("hb") messages.
CRANIUM_HEARTBEAT=10
